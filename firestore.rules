rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'eladgo55@gmail.com';
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Each user's profile — that user can read/write their own; admin can read
    // all of them (needed for the JARVIS "KALOS Users" panel) but not write others'
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    // Public registered-user counter for the landing page — nobody can read raw
    // user data from it, just a number; write is restricted to +1 increments only
    match /stats/{doc} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.users == 1;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users'])
        && request.resource.data.users == resource.data.users + 1;
    }

    // Each user's training progress — same, owner-only
    match /training/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Shared exercise videos/notes — public read, admin-only write
    match /content/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public reviews — any signed-in user can submit (always starts unapproved,
    // fields type/size-checked so a crafted request can't smuggle junk in);
    // only approved reviews (or admin) can read; only admin can moderate
    match /reviews/{doc} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.approved == false
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() < 2000
        && request.resource.data.name is string && request.resource.data.name.size() < 200;
      allow update, delete: if isAdmin();
    }

    // Low-star private feedback — anyone can submit, only admin can read/manage
    match /feedback/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Landing page config (photo/video) — public read, admin-only write
    match /landing/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
