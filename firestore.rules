rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'eladgo55@gmail.com';
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    // Anyone can submit a review (create only); only admin can update/delete
    match /reviews/{doc} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Anyone can submit low-star feedback (create only); only admin can read/manage
    match /feedback/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /landing/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
